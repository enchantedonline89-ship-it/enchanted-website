    "@supabase/supabase-js": "^2.98.0",
    "@types/three": "^0.183.1",
    "clsx": "^2.1.1",
    "motion": "^13.1.0",
    "next": "^16.3.2",
    "posthog-js": "^1.416.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.5.0",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
