# ============================================================
# ENCHANTED STYLE - environment variables
# Copy to .env.local and fill in. Never commit .env.local.
# ============================================================

# ─── Supabase (required for the shop to hold real data) ───────
# The previous project (mnbdyiemlifvxvgobfwq) no longer resolves and must be
# recreated. Until these point at a live project the storefront falls back to
# the mock catalog in lib/mock-data.ts and nobody can sign in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Preview-only escape hatch. Never enable this on the customer-facing deployment:
# production otherwise fails closed instead of advertising demo inventory.
ENABLE_MOCK_CATALOG=false

# Server-side admin gate. Every real authorization check reads this one.
ADMIN_EMAIL=
# Cosmetic only: hides the welcome modal and shows the admin nav link.
# This is public, so it must never be used for an authorization decision.
NEXT_PUBLIC_ADMIN_EMAIL=


# ─── Sentry (error tracking) ──────────────────────────────────
# Everything Sentry is a no-op while these are unset, so the site builds and
# runs perfectly well without an account.
#
# Where to get them: sentry.io -> create a Next.js project -> Settings ->
# Client Keys (DSN). The two DSN values below are the same string; Next needs
# it under both names because one is read on the server and one in the browser.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Only needed at BUILD time, for readable stack traces. Without it the app still
# reports errors, they just point at minified code.
# sentry.io -> Settings -> Auth Tokens -> scope: project:releases
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=


# ─── PostHog (product analytics) ──────────────────────────────
# Also a no-op while unset.
#
# Where to get it: posthog.com -> Project Settings -> Project API Key.
# Use the PROJECT key (starts with phc_). Never the personal API key.
NEXT_PUBLIC_POSTHOG_KEY=

# Only change this if the project is on EU cloud, in which case set it to
# https://eu.posthog.com AND change the rewrite hosts in next.config.ts from
# us.i.posthog.com / us-assets.i.posthog.com to their eu equivalents.
NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com

# Note: there is deliberately no NEXT_PUBLIC_POSTHOG_HOST here. Ingestion is
# proxied same-origin through /atelier (see next.config.ts rewrites) so that it
# survives ad blockers and needs no third-party entry in the CSP.
