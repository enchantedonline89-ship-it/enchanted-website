# Enchanted production environment
# Copy to .env.local only for local development. Never commit real values.

# Public canonical origin, without a trailing slash.
NEXT_PUBLIC_SITE_URL=

# Better Auth. Use a cryptographically random value of at least 32 characters.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
ADMIN_EMAIL=Enchantedonline89@gmail.com
ENVIRONMENT=production

# Optional Google sign-in credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Transactional email. RESEND_FROM_EMAIL must use a verified sending domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=

# Consent-gated product analytics (EU cloud by default).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_INGEST_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_ASSET_HOST=https://eu-assets.i.posthog.com
NEXT_PUBLIC_POSTHOG_UI_HOST=https://eu.posthog.com
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_HOST=https://eu.posthog.com

# Error monitoring. Browser replay starts only after analytics consent.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_API_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
