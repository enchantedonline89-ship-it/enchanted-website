{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "enchanted-style",
  "main": "cloudflare-worker.ts",
  "workers_dev": true,
  "preview_urls": true,
  "compatibility_date": "2026-08-26",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "enchanted-style"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "triggers": {
    "crons": [
      "*/15 * * * *",
      "17 2 * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "enchanted-production",
      "database_id": "0432bbf5-9c87-4f71-b7cd-cb03ebe21bdb"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "enchanted-product-media"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "EMAIL_QUEUE",
        "queue": "enchanted-email"
      }
    ],
    "consumers": [
      {
        "queue": "enchanted-email",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "enchanted-email-dlq"
      }
    ]
  },
  "vars": {
    "ADMIN_EMAIL": "Enchantedonline89@gmail.com"
  },
  "observability": {
    "enabled": true
  }
}
