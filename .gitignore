# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/.open-next/

# local deployment-tool caches and logs
/.npm-cache/
/.wrangler-logs/
/.wrangler/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# but the documented template must ship
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
cloudflare-env.d.ts

# Claude Code — AI assistant config (may contain tokens / passwords)
.claude/
.agents/
CLAUDE.md

# Generated test and tooling output
# Playwright HTML report, regenerated on every run
/playwright-report/
# Playwright artefacts
/test-results/
# Vitest coverage output
/coverage/
# skills CLI lockfile; .agents/ itself is ignored
skills-lock.json
.env*.local
.dev.vars
worker-startup.cpuprofile
